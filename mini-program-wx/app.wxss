/* 全局样式 - 黑白灰极简风格 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  background-color: #f5f5f5;
  color: #333;
  font-size: 28rpx;
  line-height: 1.5;
}

/* 文字颜色 */
.text-primary { color: #333 !important; }
.text-secondary { color: #666 !important; }
.text-muted { color: #999 !important; }
.text-white { color: #fff !important; }

/* 背景色 */
.bg-white { background-color: #fff !important; }
.bg-gray { background-color: #f5f5f5 !important; }
.bg-light { background-color: #fafafa !important; }

/* 边框 */
.border { border: 1rpx solid #e5e5e5; }
.border-bottom { border-bottom: 1rpx solid #e5e5e5; }

/* 阴影 - 极简 */
.shadow-sm {
  box-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.02);
}

.shadow {
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.02);
}

/* 按钮样式 */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.15s;
}

.btn-primary {
  background-color: #333;
  color: #fff;
}

.btn-secondary {
  background-color: #fff;
  color: #333;
  border: 1rpx solid #e5e5e5;
}

.btn-sm {
  padding: 12rpx 24rpx;
  font-size: 24rpx;
}

/* 卡片样式 */
.card {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
}

/* 安全区域适配 */
.safe-area-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 通用间距 */
.mt-8 { margin-top: 8rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-24 { margin-top: 24rpx; }
.mb-8 { margin-bottom: 8rpx; }
.mb-16 { margin-bottom: 16rpx; }
.mb-24 { margin-bottom: 24rpx; }
.p-16 { padding: 16rpx; }
.p-24 { padding: 24rpx; }

/* Flex 布局 */
.flex { display: flex; }
.flex-col { flex-direction: column; }
.items-center { align-items: center; }
.justify-between { justify-content: space-between; }
.justify-center { justify-content: center; }
.flex-1 { flex: 1; }
.gap-8 { gap: 8rpx; }
.gap-16 { gap: 16rpx; }

/* 隐藏滚动条 */
::-webkit-scrollbar {
  display: none;
  width: 0;
  height: 0;
  background: transparent;
}
