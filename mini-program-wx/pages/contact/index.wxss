.container {
  padding: 24rpx;
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 60rpx;
}

.form-card {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.form-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 32rpx;
  text-align: center;
}

.section-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.label-required::after {
  content: '*';
  color: #ff4d4f;
  margin-left: 4rpx;
}

input, textarea {
  width: 100%;
  height: 80rpx;
  padding: 0 20rpx;
  background-color: #f8f8f8;
  border: 1rpx solid #f0f0f0;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

input:focus, textarea:focus {
  border-color: #333;
  background-color: #fff;
}

textarea {
  height: 160rpx;
  padding: 20rpx;
}

.placeholder {
  color: #999;
}

.save-btn {
  width: 100%;
  height: 88rpx;
  background-color: #333;
  color: #fff;
  border-radius: 8rpx;
  font-size: 30rpx;
  font-weight: 500;
  margin-top: 16rpx;
}

.delete-btn {
  width: 100%;
  height: 88rpx;
  background-color: #fff;
  color: #ff4d4f;
  border: 1rpx solid #ff4d4f;
  border-radius: 8rpx;
  font-size: 30rpx;
  margin-top: 24rpx;
}
