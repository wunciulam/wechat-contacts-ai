{
  "manifest_version": 3,
  "name": "明亚保单导出",
  "version": "1.2.0",
  "minimum_chrome_version": "111",
  "description": "在已登录的明亚页面批量读取保单与详情，导出本地 Excel 或 JSON，不调用 AI。",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://d.mingya.com.cn/*",
    "https://wps.mingya.com.cn/*",
    "https://app.mingya.com.cn/salespolicy/*",
    "https://insurance-rose-seven.vercel.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "明亚保单导出"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.mingya.com.cn/salespolicy/*"
      ],
      "js": [
        "collector.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
